# Optional. Without a key, Deal Radar runs in heuristic mode (regex extraction + template outreach).
ANTHROPIC_API_KEY=
# Model used for extraction and outreach drafts.
CLAUDE_MODEL=claude-opus-5-5
PORT=4000
# Comma-separated origins allowed to call the API (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173
